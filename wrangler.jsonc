{
  // Cloudflare Workers 静态资源部署配置。
  // 本地验证：pnpm exec wrangler deploy --dry-run   实际部署：pnpm exec wrangler deploy
  // GitHub Actions 里由 .github/workflows/deploy.yml 执行。
  "name": "myblog",
  "compatibility_date": "2026-09-01",
  // 部署到 myblog.xiaoxiao643336.workers.dev
  // 等 643336.xyz 的 zone 变成 Active 之后，改成下面这样把自定义域名绑上：
  //   "workers_dev": false,
  //   "routes": [{ "pattern": "643336.xyz", "custom_domain": true }]
  "workers_dev": true,
  "assets": {
    "directory": "./.vitepress/dist",
    // VitePress 开了 cleanUrls：URL 是 /TypeScript/Generic，而产物文件是
    // TypeScript/Generic.html。auto-trailing-slash（默认值）正好就是
    // 「/foo 返回 foo.html」，同时把 /foo.html 307 跳到 /foo —— 这里显式写出来备查。
    "html_handling": "auto-trailing-slash",
    // VitePress 会生成 404.html，交给它处理未命中路径
    "not_found_handling": "404-page"
  }
}
